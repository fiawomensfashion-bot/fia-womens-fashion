# FIA Cloudflare Pages security headers. Place in dist root during build.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests

# Hashed assets are safe to cache for a year, with a new URL on change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/images/optimized/*
  Cache-Control: public, max-age=31536000, immutable

# Catalogue and generated image index always revalidate, so prices and stock stay fresh.
/products.js
  Cache-Control: public, max-age=0, must-revalidate
/image-manifest.js
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Shareable product and information pages must revalidate when content changes.
/p/*
  Cache-Control: public, max-age=0, must-revalidate
/about/*
  Cache-Control: public, max-age=0, must-revalidate
/delivery/*
  Cache-Control: public, max-age=0, must-revalidate
/returns/*
  Cache-Control: public, max-age=0, must-revalidate
/privacy/*
  Cache-Control: public, max-age=0, must-revalidate
/size-guide/*
  Cache-Control: public, max-age=0, must-revalidate
